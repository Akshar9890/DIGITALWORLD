# ─── Copy this file to .env and fill in your values ─────────────

# Database (Neon / Supabase / any Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/digitalworld?sslmode=require"

# Auth.js — generate with: openssl rand -hex 32
AUTH_SECRET="your-secret-here"
AUTH_URL="https://your-domain.vercel.app"

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Payments (Razorpay) ────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_live_XXXXXXXXXXXX"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_XXXXXXXXXXXX"

# ─── Email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="DigitalWorld <noreply@yourdomain.com>"

# ─── Cloudflare R2 Storage ──────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="digitalworld-assets"
R2_PUBLIC_URL=""
STORAGE_PROVIDER="r2"

# ─── Business Info ───────────────────────────────────────────────
BUSINESS_GSTIN=""
BUSINESS_STATE="Gujarat"
BUSINESS_PAN=""
BUSINESS_NAME="DigitalWorld Industrial"
BUSINESS_WHATSAPP="+917043633303"
NEXT_PUBLIC_BUSINESS_WHATSAPP="+917043633303"
BUSINESS_EMAIL="digitalworld9890@gmail.com"
BUSINESS_PHONE="+917043633303"
NEXT_PUBLIC_BUSINESS_EMAIL="digitalworld9890@gmail.com"
NEXT_PUBLIC_BUSINESS_PHONE="+91 70436 33303"

# ─── Shipping (Shiprocket API) ──────────────────────────────────
SHIPROCKET_API_EMAIL="your-shiprocket-api-user@domain.com"
SHIPROCKET_API_PASSWORD="your-shiprocket-api-password"
SHIPROCKET_WEBHOOK_SECRET="your-shiprocket-webhook-secret-token"
SHIPROCKET_PICKUP_LOCATION="Primary"
SHIPROCKET_ENABLED="true"

# ─── App Config ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NODE_ENV="production"

# ─── Supabase ───────────────────────────────────────────────────
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
